# Hisaab: copy to .env, fill in the values marked REQUIRED, then run:
#   docker compose up -d --build
# compose.yaml reads everything from here, so it never needs editing.
# Values with $ in them (e.g. a bcrypt hash) must be wrapped in single quotes.

# ---- Sign-in ------------------------------------------------------------------------------------------------
APP_USERNAME=admin
# Required while password sign-in is on. Plain text, or a bcrypt hash like '{bcrypt}$2a$10$...' (in single quotes).
APP_PASSWORD=change-me
# Offer the username/password form. false hides it, but only takes effect once OIDC below is set up, so you
# can't lock yourself out. With it off, APP_PASSWORD can be left empty.
PASSWORD_LOGIN=true

# ---- Sign-in with Pocket ID (or any OpenID Connect provider; optional) --------------------------------------
# In Pocket ID, add an OIDC client:
#   callback URL   https://<this app's address>/login/oauth2/code/oidc
#   allowed users  restrict the client to your user or group: that decides who may sign in
# Then set the three values below. The issuer is the provider's base address (it serves
# /.well-known/openid-configuration); everything else is discovered from it. Leave it empty to turn this off.
# The first time you sign in, the app asks to link that account (with the app password, if password sign-in
# is on); after that only that account gets in.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Name on the sign-in button.
OIDC_PROVIDER_NAME=Pocket ID
# Open the sign-in page straight into Pocket ID. Not after signing out or a failed sign-in, and add ?password
# to the address to reach the password form anyway.
OIDC_AUTO_REDIRECT=true

# ---- Network ------------------------------------------------------------------------------------------------
# Address and port on the host. 127.0.0.1 = only this machine. To let Caddy on your VPS reach it over
# Tailscale, use this server's Tailscale IP (e.g. 100.64.0.10), or 0.0.0.0 for every interface.
APP_BIND=127.0.0.1
APP_PORT=8080
# HTTPS needs no setting: behind Caddy (or any proxy on a private or Tailscale address) the app sees the request
# was HTTPS and marks its cookie Secure; over plain http:// on your network it uses a normal cookie.

# ---- Database -----------------------------------------------------------------------------------------------
POSTGRES_DB=hisaab
POSTGRES_USER=hisaab
# REQUIRED. Any long random string; only the app uses it.
POSTGRES_PASSWORD=change-me-too
# PostgreSQL major version for the db container. Changing it on an existing install needs a dump and restore
# (see docs/versioning.md, "Upgrading PostgreSQL"). Backups work with 17 and 18 (the app ships pg_dump 18).
POSTGRES_VERSION=17

# ---- Bank alert mailbox (optional) --------------------------------------------------------------------------
# Gmail: imap.gmail.com, iCloud: imap.mail.me.com (both 993). Use an app-specific password, not your
# account password. Leave MAIL_HOST empty to turn mailbox sync off.
MAIL_HOST=
MAIL_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
# How often to check for new mail (ISO-8601 duration: PT2M = 2 minutes, PT30S = 30 seconds).
MAIL_POLL_INTERVAL=PT2M

# ---- Prices -------------------------------------------------------------------------------------------------
# Fetch stock prices (Yahoo Finance) and mutual fund NAVs (AMFI). false = offline, no outbound requests.
PRICES_ENABLED=true

# ---- Backups ------------------------------------------------------------------------------------------------
# Where backup zips go on the host. Default ./data/backups next to compose.yaml. Set another folder, such as
# /mnt/nas/money-backups, to keep them on a different disk.
BACKUP_PATH=./data/backups
# How many backups to keep (oldest are deleted).
BACKUP_KEEP=14
# When to back up: Spring cron, "second minute hour day month weekday", in TZ below. Default 3:30 every night.
BACKUP_CRON=0 30 3 * * *

# ---- Image --------------------------------------------------------------------------------------------------
# The published image (built by GitHub Actions) and which version to run: a release like 1.4.2, a minor line
# like 1.4 (gets patch updates), "latest", or "edge" (newest commit on main). See docs/versioning.md.
APP_IMAGE=ghcr.io/rithask/hisaab

# ---- Runtime ------------------------------------------------------------------------------------------------
# Your time zone: where your days, months and years begin (daily totals, budgets, bills, "today", the nightly
# backup and the times the app shows). Times are always stored in UTC, so changing this later loses nothing; it only
# moves day boundaries. Use a name from the tz database, e.g. Asia/Kolkata, Asia/Dubai, Europe/London.
# Bank alerts, statements, card billing cycles and market hours are always read in India time, whatever this is.
TZ=Asia/Kolkata
# JVM options, e.g. a memory cap: -XX:MaxRAMPercentage=75 or -Xmx512m
JAVA_OPTS=-XX:MaxRAMPercentage=75
# Log detail for the app: ERROR, WARN, INFO or DEBUG.
LOG_LEVEL=INFO
# Version to run (an image tag): pin a release, e.g. 1.4.2, for predictable upgrades.
APP_VERSION=latest
